# Two environment variables are passed in by docker-compose.yml (set them in .env):
#   Production: SITE_ADDRESS=<domain>, TLS=tls /certs/origin.pem /certs/origin.key (Cloudflare Origin certificate)
#   Local testing: SITE_ADDRESS=:80, TLS empty, HTTP only
{$SITE_ADDRESS::80} {
	{$TLS}

	encode gzip

	# Everything under /pk/ is internal (starting games, receiving bot moves): only the services call it, so block outside access
	@internal path /api/pk /api/pk/*
	respond @internal 403

	# Forward the API to backend, stripping the /api prefix
	handle_path /api/* {
		reverse_proxy backend:8080
	}

	# WebSocket for games; Caddy handles the upgrade automatically
	handle /websocket/* {
		reverse_proxy backend:8080
	}

	# Everything else is the frontend; Vue router paths (such as /ranklist/) have no file, so serve index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
