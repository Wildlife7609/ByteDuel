# Copy to .env and fill it in: cp .env.example .env (.env is in .gitignore and never committed)

# Generate all three secrets fresh; do not reuse the ones from local development
# Database password: openssl rand -hex 24
DB_PASSWORD=
# JWT signing key (Base64): openssl rand -base64 32
JWT_SECRET=
# Shared secret for internal calls between services: openssl rand -hex 24
INTERNAL_TOKEN=

# ---- Local testing: keep these defaults and open http://localhost:HTTP_PORT ----
SITE_ADDRESS=:80
TLS=
CERTS_DIR=./certs
HTTP_PORT=80
HTTPS_PORT=443

# ---- Production: change to the following (certificates go in CERTS_DIR) ----
# SITE_ADDRESS=byteduel.dev
# TLS="tls /certs/origin.pem /certs/origin.key"
# CERTS_DIR=/home/ubuntu/kob/certs
