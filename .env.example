# 复制成 .env 再填写：cp .env.example .env（.env 已被 .gitignore 忽略，不会提交）

# 三个密钥都要随机生成，不要沿用本地开发用的
# 数据库密码：openssl rand -hex 24
DB_PASSWORD=
# JWT 签名密钥（Base64 格式）：openssl rand -base64 32
JWT_SECRET=
# 服务之间调用内部接口的共享密钥：openssl rand -hex 24
INTERNAL_TOKEN=

# ---- 本地测试：保持下面的默认值，用 http://localhost:HTTP_PORT 访问 ----
SITE_ADDRESS=:80
TLS=
CERTS_DIR=./certs
HTTP_PORT=80
HTTPS_PORT=443

# ---- 线上：改成下面这样（证书放在 CERTS_DIR 目录下） ----
# SITE_ADDRESS=byteduel.dev
# TLS="tls /certs/origin.pem /certs/origin.key"
# CERTS_DIR=/home/ubuntu/kob/certs
